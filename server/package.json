{
  "name": "@omp-cradle/server",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "^7.0.0-dev.20260704.1",
    "eslint": "^9",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript-eslint": "^8.58.1"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "16.3.5",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch ./node_modules/@oh-my-pi/pi-coding-agent/dist/cli.js --extension \"$PWD/src/index.ts\"",
    "build": "tsgo -p tsconfig.json",
    "typecheck": "tsgo --noEmit",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier . --log-level silent --write",
    "check": "bun run format && bun run lint && bun run typecheck && bun run build",
    "fix": "bun run format && bun run lint:fix"
  }
}
